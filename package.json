{
  "name": "pulse-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:cloudflare": "npm install --no-save --no-package-lock @opennextjs/cloudflare@1.20.6 wrangler@4.136.2 && opennextjs-cloudflare build",
