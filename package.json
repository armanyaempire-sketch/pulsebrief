    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.8"
  }
}
